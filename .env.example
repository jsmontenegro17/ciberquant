DATABASE_URL=postgresql+psycopg://ciberquant:ciberquant@db:5432/ciberquant
JWT_SECRET=change-me-in-development
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
VITE_API_BASE_URL=http://localhost:8000/api/v1
MARKET_DATA_MAX_UPLOAD_MB=20
MARKET_DATA_MAX_ROWS=100000
MARKET_DATA_MAX_CATALOG_CANDLES=250000
FEATURE_API_MAX_RETURN_ROWS=10000
FEATURE_ENGINE_MAX_SOURCE_CANDLES=250000
FEATURE_API_MAX_INDICATOR_SPECS=12
BACKTEST_MAX_SOURCE_CANDLES=250000
BACKTEST_MAX_TRADES=10000
ENABLE_MT5_PROVIDER=false
ENABLE_IQOPTION_EXPERIMENTAL=false
IQOPTION_EMAIL=
IQOPTION_PASSWORD=
IQOPTION_BALANCE=PRACTICE
IQOPTION_PRODUCT=turbo
# IQOPTION_SSID=  # Optional local session, never shared or logged
# IQOPTION_CANONICAL_ORIGIN=2026-09-19T00:00:00+00:00
IQOPTION_TIMEOUT_SECONDS=15
ENABLE_REPLAY_PROVIDER=false
LIVE_STALE_FACTOR=2
LIVE_CLOCK_DRIFT_SECONDS=30
LIVE_HEARTBEAT_SECONDS=15
LIVE_POLL_SECONDS=1
REPLAY_PREFIX_CANDLES=100
REPLAY_SPEED=MAX
# REPLAY_PAYOUT=84
# MT5_BROKER must equal the authenticated terminal account server, not a display alias.
# MT5_BROKER=YOUR_TERMINAL_SERVER
# MT5_CANONICAL_ORIGIN=2026-01-01T00:00:00+00:00
